PORT=5001
MONGODB_URI=mongodb://localhost:27017/securepay
# Production (Atlas): the database name in the URI names the app database (created on first write).
# MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/securepay?retryWrites=true&w=majority
JWT_SECRET=securepay_super_secret_key
JWT_EXPIRES_IN=7d
# Timezone for dashboard periods (this week/month/year). Defaults to Africa/Lagos.
APP_TIMEZONE=Africa/Lagos
# When true (default in non-production) the verification code is returned in the
# register/resend responses so the app can show it on the verify page.
# Set explicitly to false to only send it by email.
# NODE_ENV=production
# EXPOSE_VERIFICATION_CODE=true
